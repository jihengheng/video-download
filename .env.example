APP_NAME=Video Research Studio
API_PREFIX=/api
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./storage/dev.db
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_DIR=storage/object_store
WORKSPACE_DIR=storage/workspace
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=replace-with-your-deepseek-api-key
OPENAI_MODEL=deepseek-chat
DEFAULT_DAILY_QUOTA=3
ANON_DAILY_QUOTA=1
MAX_TASK_RETRIES=2
MAX_VIDEO_DURATION_SECONDS=7200
MAX_VIDEO_FILE_SIZE_MB=1024
MAX_URL_LENGTH=2048
JWT_ISSUER=video-research-studio
FRONTEND_ORIGIN=http://localhost:5173
